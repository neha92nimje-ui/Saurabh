package Com.FileOperation;

import java.io.*;
import Com.Model.Account;

public class FileOperation {

	public static void saveAccount(Account account) throws IOException {
		FileWriter filewriter = new FileWriter("accounts.txt", true);
		BufferedWriter bufferedwriter = new BufferedWriter(filewriter);
		bufferedwriter.write(account.getAccNo() + ", " + account.getAccHolderName() + ", " + account.getAadharNo()
				+ ", " + account.getPanNo() + ", " + account.getMobileNo() + ", " + account.getAddress() + ", "
				+ account.getBalance() + ", " + account.getPin());
		bufferedwriter.newLine();
		bufferedwriter.close();
		System.out.println("Account Saved Successfully...!!!");
	}
	
	
	public static void showAllAccount() throws IOException{
		FileReader filereader = new FileReader("accounts.txt");
		BufferedReader bufferedreader = new BufferedReader(filereader);
		String data;
		System.out.println("============================================");
		System.out.println("              ALL ACCOUNT DATA              ");
		System.out.println("============================================");
		while((data = bufferedreader.readLine()) != null) {
			System.out.println(data);
		}
		bufferedreader.close();
	}
	
	
		
		
	}
