package Com.FileOperation;

import java.io.*;
import Com.Model.Account;

public class FileOperation {

	public static void saveAccount(Account account) throws IOException {
		FileWriter filewriter = new FileWriter("accounts.txt", true);
		BufferedWriter bufferedwriter = new BufferedWriter(filewriter);
		bufferedwriter.write(account.getAccNo() + ", " + account.getAccHolderName() + ", " + account.getAadharNo()
				+ ", " + account.getPanNo() + ", " + account.getMobileNo() + ", " + account.getAddress() + ", "
				+ account.getBalance() + ", " + account.getPin());
		bufferedwriter.newLine();
		bufferedwriter.close();
		System.out.println("Account Saved Successfully...!!!");
	}
	
	
	public static void showAllAccount() throws IOException{
		FileReader filereader = new FileReader("accounts.txt");
		BufferedReader bufferedreader = new BufferedReader(filereader);
		String data;
		System.out.println("============================================");
		System.out.println("              ALL ACCOUNT DATA              ");
		System.out.println("============================================");
		while((data = bufferedreader.readLine()) != null) {
			System.out.println(data);
		}
		bufferedreader.close();
	}
	
	
	public static void showFileInformation() throws IOException{
		File file = new File("accounts.txt");
		
		if(file.exists()) {
			
			System.out.println("============================================");
			System.out.println("              FILE INFORMATION              ");
			System.out.println("============================================");
			System.out.print("File Name : " + file.getName());
			System.out.print("File Path : " + file.getAbsolutePath());
			System.out.print("File Size : " + file.length() + " bytes ");
			System.out.print("Can Read  : " + file.canRead());
			System.out.print("Can Write : " + file.canWrite());
		}else {
			System.out.println("accounts.txt does not exixt.");
		}
		
	}
	
	public static void backupFile() throws IOException{
		
	}
	
	public static void deleteFile() throws IOException{
		
		File file = new File("accounts_backup.txt");
		if(file.exists()) {
			if(file.delete()) {
				System.out.println("File Deleted Successfully.");
			}else {
				System.out.println("Unable to Delete The File");
			}
			
		}else {
			System.out.println("File Does Not Exist.");
		}
	}

}
